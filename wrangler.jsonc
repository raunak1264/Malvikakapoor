{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malvikakapoorart",
  "compatibility_date": "2026-06-29",
  "assets": {
    "directory": ".",
    // Serve /404.html (with a 404 status) for missing pages instead of an empty response
    "not_found_handling": "404-page",
    // /gallery serves gallery.html; /gallery.html redirects to /gallery (current behaviour)
    "html_handling": "auto-trailing-slash"
  }
}
